            <plugin>
                <groupId>com.github.davidmoten</groupId>
                <artifactId>jax-maven-plugin</artifactId>
                <version>0.2</version>
                <executions>
                    <execution>
                        <id>xjc-generate-from-schemas</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <systemProperties>
                                <enableExternalEntityProcessing>true</enableExternalEntityProcessing>
                            </systemProperties>
                            <jvmArguments>
                                <jvmArgument>-Xms32m</jvmArgument>
                                <jvmArgument>-Djavax.xml.accessExternalSchema=all</jvmArgument>
                                <jvmArgument>-Djavax.xml.accessExternalDTD=all</jvmArgument>
                            </jvmArguments>
                            <arguments>
                                <!-- These are the arguments you would normally have put with a call to xjc -->
                                <argument>-verbose</argument>
                                <argument>-d</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.basedir}/src/main/schemas</argument>
                                <argument>-b</argument>
                                <argument>${project.basedir}/src/main/xjb</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
